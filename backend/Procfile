# ============================================================================
# UNIFIND Backend - Heroku Procfile
# ============================================================================
# Standardized entrypoint using gunicorn for production reliability
# ============================================================================

# Web process: Production server with gunicorn + uvicorn workers
web: gunicorn app.main:app --worker-class uvicorn.workers.UvicornWorker --workers ${WORKERS:-4} --bind 0.0.0.0:${PORT:-8000} --timeout 120 --keepalive 5 --max-requests 1000 --max-requests-jitter 100 --access-logfile - --error-logfile - --log-level info --preload --graceful-timeout 30

# Release phase: Run migrations or startup validation (optional)
# release: python scripts/startup_validation.py

